{
  "name": "nest-webtransport",
  "version": "0.0.0",
  "description": "WebTransport abstractions and NestJS integration",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pack:check": "bun run build && bun run --filter './packages/*' publint",
    "check": "bun run lint && bun run typecheck && bun run test && bun run pack:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "trustedDependencies": [
    "rwebtransport"
  ]
}
