{
  "name": "nest-webtransport-workspace",
  "version": "0.0.0",
  "description": "WebTransport abstractions and NestJS integration",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "node scripts/vendor-rwebtransport.mjs && tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "examples:typecheck": "bun run --filter './examples/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pack:check": "bun run build && bun run --filter './packages/*' publint",
    "check": "bun run lint && bun run typecheck && bun run examples:typecheck && bun run test && bun run pack:check",
    "test:native": "bun run build && node --test tests/native.test.mjs",
    "test:browser": "bun run build && node --test tests/browser.test.mjs",
    "test:soak": "bun run build && node --expose-gc --test tests/soak.test.mjs",
    "test:install": "bun run build && node scripts/test-install.mjs",
    "release:check": "node scripts/check-runtime.mjs && bun run check && bun run test:native && bun run test:browser && bun run test:abrupt && bun run test:soak && bun run test:install",
    "test:abrupt": "bun run build && node --test tests/abrupt.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "webtransport-core": "workspace:*",
    "webtransport-driver-rwebtransport": "workspace:*",
    "nest-webtransport": "workspace:*",
    "nest-webtransport-otel": "workspace:*",
    "nest-webtransport-testing": "workspace:*"
  },
  "trustedDependencies": [
    "rwebtransport"
  ],
  "license": "MIT"
}
