{
  "name": "nest-webtransport-testing",
  "version": "1.0.0-rc.1",
  "description": "Test doubles for NestJS WebTransport applications",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/testing/src",
    "publint": "publint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "webtransport-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luvxxxu/nest-webtransport.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/luvxxxu/nest-webtransport#readme",
  "bugs": {
    "url": "https://github.com/luvxxxu/nest-webtransport/issues"
  }
}
