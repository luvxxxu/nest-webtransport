{
  "name": "nest-webtransport-testing",
  "version": "0.0.0",
  "description": "Test doubles for NestJS WebTransport applications",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "webtransport-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
