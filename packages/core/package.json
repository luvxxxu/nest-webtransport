{
  "name": "webtransport-core",
  "version": "0.1.0",
  "description": "Runtime-neutral WebTransport contracts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/core/src",
    "publint": "publint",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luvxxxu/nest-webtransport.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/luvxxxu/nest-webtransport#readme",
  "bugs": {
    "url": "https://github.com/luvxxxu/nest-webtransport/issues"
  }
}
