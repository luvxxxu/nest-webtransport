{
  "name": "webtransport-driver-rwebtransport",
  "version": "0.1.0",
  "description": "rwebtransport driver for the WebTransport core contracts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "LICENSE",
    "vendor"
  ],
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/driver-rwebtransport/src",
    "publint": "publint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "webtransport-core": "workspace:*",
    "rwebtransport": "0.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luvxxxu/nest-webtransport.git",
    "directory": "packages/driver-rwebtransport"
  },
  "homepage": "https://github.com/luvxxxu/nest-webtransport#readme",
  "bugs": {
    "url": "https://github.com/luvxxxu/nest-webtransport/issues"
  }
}
