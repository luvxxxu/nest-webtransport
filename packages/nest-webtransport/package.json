{
  "name": "nest-webtransport",
  "version": "1.0.0-rc.1",
  "description": "NestJS integration for WebTransport",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/nest-webtransport/src",
    "publint": "publint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "webtransport-core": "workspace:*",
    "webtransport-driver-rwebtransport": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luvxxxu/nest-webtransport.git",
    "directory": "packages/nest-webtransport"
  },
  "homepage": "https://github.com/luvxxxu/nest-webtransport#readme",
  "bugs": {
    "url": "https://github.com/luvxxxu/nest-webtransport/issues"
  }
}
