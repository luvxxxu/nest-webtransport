{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.spec.ts",
    "packages/**/*.test.ts",
    "examples/**/*.spec.ts",
    "examples/**/*.test.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
