{
  "name": "nest-webtransport-example-web-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cert": "node scripts/generate-dev-certificate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "nest-webtransport": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "webtransport-driver-rwebtransport": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
